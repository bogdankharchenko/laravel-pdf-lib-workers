{
    "name": "bogdankharchenko/laravel-pdf-lib-workers",
    "description": "Laravel client for the pdf-lib-workers API: merge, edit, fill, stamp and inspect PDFs on Cloudflare Workers. Generated from the API's OpenAPI spec.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "pdf", "pdf-lib", "cloudflare-workers", "openapi"],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "spatie/laravel-data": "^4.23"
    },
    "require-dev": {
        "nette/php-generator": "^4.1",
        "orchestra/testbench": "^10.0|^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "BogdanKharchenko\\PdfLibWorkers\\": ["src/", "generated/"]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BogdanKharchenko\\PdfLibWorkers\\Generator\\": "generator/src/",
            "BogdanKharchenko\\PdfLibWorkers\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "generate": "php generator/generate.php",
        "spec": "php generator/pull-spec.php",
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "extra": {
        "laravel": {
            "providers": ["BogdanKharchenko\\PdfLibWorkers\\PdfLibWorkersServiceProvider"],
            "aliases": { "PdfLib": "BogdanKharchenko\\PdfLibWorkers\\Facades\\PdfLib" }
        }
    },
    "config": { "sort-packages": true },
    "minimum-stability": "stable",
    "prefer-stable": true
}
